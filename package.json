{
    "name": "auth0-singpass-extension",
    "version": "1.2.0",
    "description": "Token endpoint for client assertion exchange",
    "main": "index.js",
    "scripts": {
      "build": "npm run clean && npm run extension:build",
      "clean": "rimraf dist",
      "extension:build": "a0-ext build:server ./index.js ./dist && cp ./dist/auth0-singpass-extension.extension.$npm_package_version.js ./build/bundle.js"
      },
    "keywords": [
        "auth0",
        "client-assertion",
        "singpass",
        "private_key_jwt"
    ],
    "author": "vikasjayaram",
    "license": "ISC",
    "dependencies": {
        "axios": "^0.32.0",
        "body-parser": "~1.18.2",
        "express": "~4.16.2",
        "jose": "^3.15.4",
        "uuid": "8.3.1"
    },
    "devDependencies": {
        "auth0-extensions-cli": "^4.0.4"
    },
    "auth0-extension": {
      "useBabel": false,
      "useHashName": false,
      "externals": [
        "axios@0.21.1",
        "body-parser@1.12.4",
        "express@4.17.1",
        "morgan@1.9.1",
        "uuid@8.3.1",
        "webtask-tools",
        "winston@3.1.0",
        "jose@3.18.0"
      ],
      "excluded": [
        "safe-eval",
        "express-conditional-middleware",
        "pino"
      ]
    },
    "overrides": {
        "compression": "1.8.2",
        "adm-zip": "0.6.1",
        "js-yaml": "3.15.2",
        "browserslist": "4.28.7",
        "postcss": "8.5.18",
        "brace-expansion": "1.1.16",
        "websocket-driver": "0.7.5",
        "form-data": "2.5.6",
        "tmp": "0.2.6",
        "@babel/plugin-transform-modules-systemjs": "7.29.4",
        "lodash": "4.18.1",
        "path-to-regexp": "0.1.13",
        "node-forge": "1.4.0",
        "minimatch": "3.1.3",
        "serialize-javascript": "7.0.3",
        "koa": "2.16.4",
        "pbkdf2": "3.1.3",
        "sha.js": "2.4.12",
        "cipher-base": "1.0.5",
        "elliptic": "6.6.1",
        "ws": "6.2.3",
        "braces": "3.0.3",
        "webpack-dev-middleware": "5.3.4",
        "browserify-sign": "4.2.2",
        "@babel/traverse": "7.23.2",
        "minimist": "1.2.6",
        "qs": "6.10.3",
        "decode-uri-component": "0.2.1",
        "loader-utils": {
            ".": "1.4.1",
            "json5": "1.0.2"
        },
        "async@^2.0.0": "2.6.4",
        "eventsource": "1.1.1",
        "ejs": "3.1.7",
        "ansi-regex": "4.1.1",
        "url-parse": "1.5.8",
        "follow-redirects": "1.14.7",
        "json5": "2.2.2"
    }
}
